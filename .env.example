# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://priorart:priorart@localhost:5432/priorart

# Embeddings: "local" (open model, needs the [local] extra), "voyage" (API) or "mistral" (API)
EMBEDDER=local
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
VOYAGE_DIM=1024
MISTRAL_API_KEY=
EMBED_MODEL=mistral-embed
EMBED_DIM=1024
# Price per million tokens, in your currency. Check the provider price page, then fill it in
# so that `priorart index` can show a cost estimate before sending anything.
EMBED_PRICE_PER_M_TOKENS=

# Answers. "claude-code" uses the `claude` command line tool signed in with a Claude
# subscription (no API key, temperature cannot be set). "api" uses an API key.
ANSWERER=claude-code
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5

# Search (tune on the development set)
RRF_K=60
CANDIDATES=50
TOP_K=10
ABSTAIN_BELOW=0.0

# Hosted version only (see docs/deploy_vercel.md)
# AUTH_REQUIRED=1 asks every visitor for an invite code and applies the limits below.
AUTH_REQUIRED=0
SESSION_SECRET=
RATE_LIMIT_PER_HOUR=10
ANTHROPIC_RATE_LIMIT_PER_HOUR=10
PUBLIC_LIMITS=0
DAILY_CAP=200
ANTHROPIC_DAILY_CAP=50
