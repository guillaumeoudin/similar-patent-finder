# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://priorart:priorart@localhost:5432/priorart

# Embeddings: "mistral" (API) or "local" (open model, needs the [local] extra)
EMBEDDER=mistral
MISTRAL_API_KEY=
EMBED_MODEL=mistral-embed
EMBED_DIM=1024
# Price per million tokens, in your currency. Check the provider price page, then fill it in
# so that `priorart index` can show a cost estimate before sending anything.
EMBED_PRICE_PER_M_TOKENS=

# Answers
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5

# Search (tune on the development set)
RRF_K=60
CANDIDATES=50
TOP_K=10
ABSTAIN_BELOW=0.0
